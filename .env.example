# ==============================================================================
# TechSrijan'27 Frontend Environment Configuration (.env.example)
# ==============================================================================

# 1. Backend API Service URL
# Local: http://localhost:4000 | Production: https://techsrijan-backend.onrender.com
BACKEND_API_URL=https://techsrijan-backend.onrender.com
NEXT_PUBLIC_API_URL=https://techsrijan-backend.onrender.com

# 2. Canonical Website Domain
NEXT_PUBLIC_APP_URL=https://www.techsrijan.org

# 3. Google OAuth 2.0 Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 4. JWT Security Secret (Must match Backend JWT_SECRET)
JWT_SECRET=your_jwt_secret_minimum_32_characters

# 5. Cloudinary Image Delivery
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_ENABLE_CLOUDINARY=true

# 6. Cloudflare Turnstile Site Key (Public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...

# 7. MMMUT SSO Configuration
NEXT_PUBLIC_MMMUT_SSO_PORTAL_URL=https://mmmut.xyz/auth/Login
NEXT_PUBLIC_MMMUT_SSO_CLIENT_ID=techsrijan
NEXT_PUBLIC_MMMUT_SSO_VERIFY_URL=https://backend.mmmut.xyz/api/student/sso/verify

